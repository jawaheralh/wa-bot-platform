# ===============================================================
#  متغيرات التشغيل والأسرار فقط.
#  إعدادات المنشآت والوحدات (ساعات العمل، النبرة، قاعدة المعرفة)
#  مكانها قاعدة البيانات وتُحرَّر من صفحة الأدمن، لا من هنا.
# ===============================================================

# --- الخادم ---
PORT=4000
HOST=127.0.0.1
# سرّ توقيع كوكي الجلسة. ولّديه بـ:  openssl rand -hex 32
SESSION_SECRET=
# العنوان العام في الإنتاج (مثل https://bot.example.com).
# وجوده يعني «خادم على الإنترنت»: يرفض النظام الإقلاع بسرّ ضعيف،
# وينبّه في السجل على أي حساب ما زال بكلمة مرور البذرة.
PUBLIC_URL=

# فتح لوحة التحكم على العنوان العام ليدخلها موظفو خدمة العملاء من أي مكان.
# افتراضياً 0: العنوان العام لا يقبل إلا /webhook، واللوحة تحتاج نفقاً.
# اجعليها 1 فقط بعد تغيير كلمات المرور الافتراضية — المحادثات كلها خلفها.
PUBLIC_PANEL=0

LOG_LEVEL=info

# --- مزوّد واتساب: baileys (تجربة بـQR) | cloud (إنتاج رسمي) | simulator (تطوير) ---
WA_PROVIDER=simulator

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- رقم الدعم الذي يظهر لأدمن المنشأة عند الوحدات المعطّلة ---
# يُترك فارغاً ما لم يكن الرقم رقم المنصة نفسها: رقم عميل هنا
# يُعرض لعملاء آخرين وكأنه رقمها. وبالفراغ تختفي أزرار التواصل
# من صفحة الهبوط ومن شاشة الوحدات.
SUPPORT_WHATSAPP=

# --- رقم المنصة للرسائل التي لا تخصّ منشأة ---
# رمز استرجاع كلمة المرور لأدمن النظام يُرسل من رقم منشأة، لأن المنصة
# نفسها بلا رقم. هنا يُحدَّد رقم تلك المنشأة (id). الفارغ يعني: اختر
# أول منشأة تستطيع الإرسال فعلاً — لا أول منشأة بالترتيب، فقد تكون
# منشأة تجربة بلا توكن فيفشل الإرسال صامتاً.
PLATFORM_WA_TENANT=

# --- البريد: قناة استرجاع ثانية، وأرخص من واتساب ---
# رسائل الاسترجاع بالعشرات شهرياً وهي داخل الطبقة المجانية لدى
# resend.com و brevo.com، بينما كل رمز على واتساب محادثة تُحاسِب
# عليها Meta. اتركه فارغاً ويبقى واتساب وحده.
#
# يلزم نطاق موثّق بسجلات SPF وDKIM لدى المزوّد — وبدونه تقع الرسالة
# في «المهملات» فيتصل العميل رغم وجود الميزة.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# --- الرسائل الصوتية (اختياري) ---
# بلا مفتاح تُعطَّل الميزة تلقائياً ويطلب البوت رسالة نصية بلطف.
ENABLE_VOICE=1
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_BASE_URL=https://api.openai.com/v1

# --- WhatsApp Cloud API (يلزم فقط عند WA_PROVIDER=cloud) ---
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v23.0

# --- سلوك ---
# وضع المراقبة: يستقبل رسائل العملاء ويعرضها في اللوحة ولا يُرسل شيئاً
# إطلاقاً — لا رد بوت، ولا رد موظف، ولا تنبيه، ولا تذكير موعد.
# استعمليه لترى ما يصل الرقم قبل أن يتكلم النظام باسمك.
READ_ONLY=0
# دقائق صمت البوت بعد تدخّل الموظف يدوياً
SILENT_MINUTES=120
# عدد الرسائل المحفوظة كسياق لكل محادثة
HISTORY_LIMIT=20

# --- النسخ الاحتياطي إلى تخزين أوراكل ---
# رابط رفع بصلاحية «كتابة فقط» (Pre-Authenticated Request) ينتهي بـ /o/
# لو تسرّب لم يُقرأ به شيء ولم يُحذف — رفع فقط.
BACKUP_PAR_URL=
# عبارة تشفير النسخ. احفظيها خارج الخادم: بلا نسخة منها لا تُفكّ النسخ أبداً.
BACKUP_PASSPHRASE=

# --- إخفاء بيانات العملاء قبل إرسالها للنموذج ---
# أرقام الجوال والهوية والآيبان والبطاقات والبريد تُستبدل برموز قبل
# مغادرة الخادم، وتعود لأصلها في مدخلات الأدوات وفي الرد.
# البيانات كاملة تبقى في قاعدة البيانات داخل السعودية.
# 0 يُعطّل الإخفاء — لا تفعليها إلا لتشخيص عطل.
REDACT_PII=1

# --- توارث بيانات Meta ---
# 0 (الافتراضي) = كل منشأة ببياناتها هي. المنشأة بلا توكن لا ترسل شيئاً
#   وتظهر رسالة صريحة — أفضل من أن تعمل تحت تطبيق عميل آخر بصمت.
# 1 = المنشأة الفارغة ترث قيم .env أعلاه. ولا تُفعَّل إلا إن كانت كل
#   المنشآت تحت حساب Meta واحد يخصّك أنت.
SHARED_META_FALLBACK=0

# --- المتابعة قبل إغلاق نافذة الأربع والعشرين ساعة ---
# 1 (الافتراضي) = رسالة متابعة واحدة قبل الإغلاق بساعتين لمن له طلب أو
#   شكوى ما زالت مفتوحة. مجانية داخل النافذة، وردّ العميل يفتح نافذة
#   جديدة — فتوفّر كلفة القوالب. لا تُرسل لمن لا شيء معلّق له.
FOLLOWUP=1

# اسم المنصة التجاري كما يظهر في صفحة الهبوط — غيّريه هنا وحده.
BRAND_NAME=واتصال
