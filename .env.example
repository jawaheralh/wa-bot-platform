# ===============================================================
#  متغيرات التشغيل والأسرار فقط.
#  إعدادات المنشآت والوحدات (ساعات العمل، النبرة، قاعدة المعرفة)
#  مكانها قاعدة البيانات وتُحرَّر من صفحة الأدمن، لا من هنا.
# ===============================================================

# --- الخادم ---
PORT=4000
HOST=127.0.0.1
# سرّ توقيع كوكي الجلسة. ولّديه بـ:  openssl rand -hex 32
SESSION_SECRET=
# العنوان العام في الإنتاج (مثل https://bot.example.com).
# وجوده يعني «خادم على الإنترنت»: يرفض النظام الإقلاع بسرّ ضعيف،
# وينبّه في السجل على أي حساب ما زال بكلمة مرور البذرة.
PUBLIC_URL=
LOG_LEVEL=info

# --- مزوّد واتساب: baileys (تجربة بـQR) | cloud (إنتاج رسمي) | simulator (تطوير) ---
WA_PROVIDER=simulator

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- رقم الدعم الذي يظهر لأدمن المنشأة عند الوحدات المعطّلة ---
SUPPORT_WHATSAPP=966500000000

# --- الرسائل الصوتية (اختياري) ---
# بلا مفتاح تُعطَّل الميزة تلقائياً ويطلب البوت رسالة نصية بلطف.
ENABLE_VOICE=1
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_BASE_URL=https://api.openai.com/v1

# --- WhatsApp Cloud API (يلزم فقط عند WA_PROVIDER=cloud) ---
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v23.0

# --- سلوك ---
# دقائق صمت البوت بعد تدخّل الموظف يدوياً
SILENT_MINUTES=120
# عدد الرسائل المحفوظة كسياق لكل محادثة
HISTORY_LIMIT=20
