# خدمة systemd — تشغّل النظام تلقائياً عند إقلاع الخادم وتعيده إن تعطّل.
#
# التثبيت:
#   sudo cp deploy/wa-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now wa-bot
#   sudo journalctl -u wa-bot -f      # متابعة السجل

[Unit]
Description=منصة بوت واتساب
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wabot
WorkingDirectory=/opt/wa-bot
ExecStart=/usr/bin/node src/index.ts
Restart=always
RestartSec=5

# السجل إلى journald، فيُقرأ بـ journalctl ولا يملأ القرص
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wa-bot

# تقوية: الخدمة لا تحتاج أكثر من مجلدها
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wa-bot/data

[Install]
WantedBy=multi-user.target
