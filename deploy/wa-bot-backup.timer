[Unit]
Description=نسخة احتياطية يومية لقاعدة بوت واتساب

[Timer]
# ٣:٣٠ فجراً بتوقيت الرياض — أهدأ ساعة، وقبل دوام خدمة العملاء.
OnCalendar=*-*-* 03:30:00 Asia/Riyadh
# خادم كان مطفأً وقت الموعد يأخذ نسخته عند عودته لا ينتظر الغد.
Persistent=true
# تشتيت دقائق قليلة حتى لا تصطدم بمهام أخرى في نفس اللحظة.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
